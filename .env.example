# Plantilla de variables de entorno — LinkGuard Backend
# Copiar a `.env` y ajustar los valores según el entorno local.
# `.env` está excluido de Git: nunca se versionan valores reales.

# Entorno de ejecución: development | testing | production
ENVIRONMENT=development

# Puerto de escucha del servicio (Render usa 10000 en producción).
PORT=8000

# Orígenes autorizados por CORS, separados por coma.
# En producción: el dominio del frontend desplegado en Vercel.
CORS_ORIGINS=http://localhost:5173

# Tiempo máximo de espera de la API de reputación, en segundos (RF-402).
PHISHTANK_TIMEOUT=4.0

# TTL de la caché LRU volátil de PhishTank, en segundos (RF-403).
PHISHTANK_TTL_SECONDS=7200

# Límite de peticiones por minuto por dirección IP (RNF-105).
RATE_LIMIT_PER_MINUTE=30

# Endpoint público de consulta de PhishTank (no requiere credenciales).
PHISHTANK_API_URL=https://checkurl.phishtank.com/checkurl/
